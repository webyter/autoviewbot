# Required
SESSION_SECRET=change-this-to-a-random-string
GROQ_API_KEY=your-groq-api-key-here

# Optional — but set PUBLIC_URL to your real public https URL: it is what
# generated invite links and the keep-alive self-ping point at.
PORT=3000
NODE_ENV=development
PUBLIC_URL=https://your-app-url.com
BOT_NAME=Alex
OWNER_NAME=Owner
SESSION_DIR=./session
SOCKS5_PROXY=
HTTPS_PROXY=
# Optional admin bootstrap (comma separated platform usernames, e.g. ADMIN_USERNAMES=moi)
ADMIN_USERNAMES=
# Invite-only registration: comma-separated invite codes. Registration is
# CLOSED when unset — unless admin-managed codes exist (generated from the
# Admin Panel, stored in session/invites.json), which are honored alongside
# these. Users without a code are told to contact the admin.
INVITE_CODE=
# Admin WhatsApp number shown on the login/register pages
ADMIN_CONTACT=233531556024
