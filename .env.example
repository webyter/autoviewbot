# ─────────────────────────────────────────────────────────────────────────────
# AutoViewer — environment configuration
#
# Every value here is OPTIONAL: the app ships with working defaults
# so a fresh clone runs out of the box. The one exception is GROQ_API_KEY:
# no key is shipped with the code — set your own for ChatAI.
# Set your own values for anything you care about.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required for real deployments ───────────────────────────────────────────
# Signs the dashboard session cookies. If unset, the app generates one and
# persists it to SESSION_DIR/.session_secret (survives restarts on a
# persistent disk). Set it explicitly for multi-instance deployments.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# ── AI (Groq) ────────────────────────────────────────────────────────────────
# Required for ChatAI and voice-note transcription. No key is shipped with the
# code — get yours at https://console.groq.com/keys and set it here (or in the
# Render service environment). Without a key the AI features stay off.
GROQ_API_KEY=
# Chat model. Must be available to your key. Default: openai/gpt-oss-120b
# (fallbacks: openai/gpt-oss-20b, qwen/qwen3.8-27b).
GROQ_MODEL=openai/gpt-oss-120b

# ── Server ───────────────────────────────────────────────────────────────────
# Which env files to load, in order (default: config.env,.env).
# CONFIG_ENV_FILES=/run/secrets/app.env
PORT=3000
# production enables the secure session cookie (see COOKIE_SECURE)
NODE_ENV=production
# Public base URL — used for invite links and the keep-alive self-ping.
PUBLIC_URL=https://your-app-url.com
# How many bots may run at once (also settable in the admin panel)
MAX_INSTANCES=5
# Where sessions + the user DB live (must be a persistent disk)
SESSION_DIR=./session

# ── Proxy / TLS ──────────────────────────────────────────────────────────────
# Number of proxy hops to trust for X-Forwarded-For. Set 0 when the app is
# exposed directly (the default is to trust one hop).
TRUST_PROXY=1
# Cookie security: true | false | unset (unset => secure when NODE_ENV=production)
# Set false only when the dashboard is served over plain HTTP.
COOKIE_SECURE=false
# Outbound proxy for WhatsApp connections (optional)
SOCKS5_PROXY=
HTTPS_PROXY=

# ── Branding ─────────────────────────────────────────────────────────────────
BOT_NAME=Alex
OWNER_NAME=Owner

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated platform usernames promoted to admin (comma separated).
ADMIN_USERNAMES=
# Invite-only registration: comma-separated codes. Registration is CLOSED when
# unset — unless admin-managed codes exist (generated in the Admin Panel,
# stored in session/invites.json), which are honoured alongside these.
INVITE_CODE=
# Admin WhatsApp number shown on the login/register pages
ADMIN_CONTACT=233531556024

# ── Keep-alive (hosts that sleep when idle) ───────────────────────────────────
# Render Free spins a service down after 15 minutes without inbound traffic.
# When a public URL is known the app pings <public url>/health every ~9
# minutes so it never reaches the idle window. The platform is detected
# automatically (RENDER / RAILWAY / FLY / REPL_ID) and the platform-provided
# public URL is used when PUBLIC_URL is unset.
# KEEPALIVE_URL=http://localhost:3000
# KEEPALIVE_INTERVAL_MIN=9

# ── Operations ───────────────────────────────────────────────────────────────
# Per-worker heap cap in MB (leave unset to use Node's default)
#WORKER_MEM_MB=512
