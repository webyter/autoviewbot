# Required
SESSION_SECRET=change-this-to-a-random-string
GROQ_API_KEY=your-groq-api-key-here

# Optional
PORT=3000
NODE_ENV=development
PUBLIC_URL=https://your-app-url.com
BOT_NAME=Alex
OWNER_NAME=Owner
SESSION_DIR=./session
SOCKS5_PROXY=
HTTPS_PROXY=
# Session backup to Supabase Storage (survives Render free-tier disk wipes).
# Create a private bucket named BACKUP_BUCKET in your Supabase project and
# paste the project URL + service_role key. Leave empty to disable.
BACKUP_SUPABASE_URL=
BACKUP_SUPABASE_KEY=
BACKUP_BUCKET=autoviewbot-backup
BACKUP_PATH=session-backup.enc
# Optional admin bootstrap (comma separated platform usernames, e.g. ADMIN_USERNAMES=moi)
ADMIN_USERNAMES=
# Invite-only registration: comma-separated invite codes. Registration is
# CLOSED when unset. Users without a code are told to contact the admin.
INVITE_CODE=
# Admin WhatsApp number shown on the login/register pages
ADMIN_CONTACT=233531556024
